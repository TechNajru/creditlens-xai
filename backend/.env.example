# Copy to .env (never commit .env). No real credentials belong in this file.
CREDITLENS_SEED=42
# The website's address. Cookies need the frontend and API on the same site: use localhost for both.
CREDITLENS_CORS_ORIGINS=http://localhost:3000
# Database (default: SQLite file in backend/data). PostgreSQL example: postgresql+psycopg://user:pass@host/dbname
# CREDITLENS_DATABASE_URL=
# Sessions
CREDITLENS_SESSION_HOURS=8
# Set to true when serving over HTTPS (required for any real deployment)
CREDITLENS_COOKIE_SECURE=false
CREDITLENS_MAX_FAILED_LOGINS=5
CREDITLENS_LOCKOUT_MINUTES=15
# Optional overrides:
# CREDITLENS_MODELS_DIR=
# CREDITLENS_REGISTRY_DIR=
# CREDITLENS_REPORTS_DIR=
